# Frontend env example — copy to .env.development (local) or set in Vercel dashboard (prod).

# Backend API base. Empty/unset in development falls back to a hardcoded
# production URL, which is wrong for local dev — set this explicitly.
# Local:  https://accounting.hejazfinancial.com/api
# Prod:   https://accounting.hejazfinancial.com/api
VITE_API_URL=https://accounting.hejazfinancial.com/api
