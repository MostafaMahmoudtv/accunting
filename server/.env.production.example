# .env.production — committed as an EXAMPLE so the deploy knows which keys
# to read from Railway environment variables. Real values come from Railway,
# NOT from this file (Railway dashboard > Variables). The actual .env.production
# (if created locally) MUST stay gitignored.

# All values below MUST be set as environment variables in the Railway
# dashboard. Do NOT put real secrets here.

PORT=8080
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.sjvjzqc.mongodb.net/accounting-platform?retryWrites=true&w=majority
JWT_SECRET=generate_with_`node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_EXPIRES_IN=7d
# When the client is hosted on the same Railway service, leave this as
# '*' or use the auto-generated Railway domain. For separate client
# hosting (Vercel, Netlify, custom), use the full client origin URL.
CLIENT_URL=*
NODE_ENV=production

# --- Email (Resend) ---
# Get an API key from https://resend.com/api-keys. MAIL_FROM defaults to
# onboarding@resend.dev (works without a custom domain).
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Ledgerly
